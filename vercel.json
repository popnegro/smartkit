{
  "version": 2,
  "builds": [
    {
      "src": "./build.sh",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "rewrites": [
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/mediakit", "destination": "/mediakit.html" },
    {
      "source": "/:path((?!.*\\.).*)", "destination": "/index.html"
    }
  ]
}