<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SmartKit · Dashboard</title>
<link rel="stylesheet" href="dashboard.css?v=d63c2d9">
</head>
<body style="visibility: hidden;">

<div class="app" id="app">
  <aside class="sidebar">
    <button class="sb-toggle" id="sb-toggle" title="Colapsar menú">‹</button>
    <div class="brand">
      <div class="logo" id="dash-logo">SK</div>
      <div class="brand-text">
        <strong id="dash-brand">SmartKit</strong>
        <span>Gestión DOOH</span>
      </div>
    </div>
    <nav class="menu">
      <button class="nav-btn on" data-sec="inventory" title="Inventario"><i>📦</i><span>Inventario</span></button>
      <button class="nav-btn" data-sec="mediakits" title="Media Kits"><i>📄</i><span>Media Kits</span></button>
      <button class="nav-btn" data-sec="metrics" title="Métricas"><i>📈</i><span>Métricas</span></button>
      <button class="nav-btn" data-sec="settings" title="Configuración"><i>⚙️</i><span>Configuración</span></button>
    </nav>
    <div class="sb-footer">
      <a href="index.html" target="_blank">← Brochure público</a><br>
      <a href="map.html" target="_blank">← Mapa de pantallas</a><br>
      <button id="logout-btn">Cerrar sesión</button>
    </div>
  </aside>

  <main class="main">
    <header class="topbar">
      <div>
        <span class="eyebrow">Dashboard</span>
        <h1 id="page-title">Gestión de pantallas</h1>
        <p id="page-desc">Inventario, precios, disponibilidad y propuestas comerciales.</p>
      </div>
      <div class="actions">
        <button class="btn" id="btn-export">Exportar CSV</button>
        <button class="btn pri" id="btn-save">Guardar cambios</button>
        <span class="badge-warn" id="unsaved" style="display:none">● Cambios sin guardar</span>
      </div>
    </header>

    <section class="kpis" id="kpis-row"></section>

    <!-- INVENTORY -->
    <section class="section on" id="sec-inventory">
      <div class="layout">
        <div class="panel">
          <div class="panel-head">
            <div><span class="eyebrow">Inventario</span><h2>Pantallas</h2></div>
            <div style="display:flex;align-items:center;gap:8px">
              <span class="badge bd-ok" id="result-count">0 resultados</span>
            </div>
          </div>
          <div class="bulk-bar" id="bulk-bar">
            <span class="badge bd-warn"><span id="bulk-count">0</span> seleccionadas</span>
            <button class="btn sm ok" data-bulk="Activo">Publicar</button>
            <button class="btn sm" data-bulk="Pausado">Pausar</button>
            <button class="btn sm ghost" id="bulk-clear">Limpiar</button>
          </div>
          <div class="filters">
            <div class="field grow"><label>Buscar</label><input type="search" id="f-search" placeholder="Nombre, zona…"></div>
            <div class="field"><label>Zona</label><select id="f-zone"></select></div>
            <div class="field"><label>Tipo</label>
              <select id="f-type"><option>Todos</option><option>Peatonal</option><option>Vehicular</option><option>Mixto</option></select>
            </div>
            <div class="field"><label>Estado</label>
              <select id="f-status"><option>Todos</option><option>Activo</option><option>Pausado</option></select>
            </div>
          </div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th style="width:36px"><input type="checkbox" id="sel-all"></th>
                  <th class="sort" data-k="nombre">Pantalla</th>
                  <th class="sort" data-k="tipo">Tipo</th>
                  <th class="sort" data-k="impactos">Impactos/día</th>
                  <th class="sort" data-k="precio">Precio/sem</th>
                  <th>Estado</th>
                  <th>Acciones</th>
                </tr>
              </thead>
              <tbody id="screen-tbody"></tbody>
            </table>
          </div>
        </div>

        <aside class="panel drawer" id="editor-panel">
          <div class="panel-head" style="border-bottom:1px solid var(--ln)">
            <div><span class="eyebrow">Detalle</span><h2 id="ed-title">Seleccioná una pantalla</h2></div>
          </div>
          <div id="editor-body"><p class="empty-sel">Hacé clic en ✏️ para editar una pantalla.</p></div>
        </aside>
      </div>
    </section>

    <!-- MEDIA KITS -->
    <section class="section" id="sec-mediakits">
      <div class="kit-layout">
        <div class="panel">
          <div class="panel-head">
            <div><span class="eyebrow">Media Kit</span><h2>Constructor de propuesta</h2></div>
            <span class="badge bd-warn" id="kit-draft-badge">Borrador</span>
          </div>
          <div class="filters">
            <div class="field grow"><label>Cliente</label><input id="kit-client" placeholder="Ej: Bodega Trapiche"></div>
            <div class="field"><label>Contacto</label><input id="kit-contact" placeholder="Nombre"></div>
            <div class="field"><label>Duración</label>
              <select id="kit-dur">
                <option value="1">1 semana</option><option value="2">2 semanas</option>
                <option value="4" selected>4 semanas</option><option value="8">8 semanas</option>
                <option value="12">12 semanas</option>
              </select>
            </div>
            <div class="field"><label>Zona</label><select id="kit-zone"></select></div>
            <div class="field"><label>Validez</label>
              <select id="kit-validity"><option value="7">7 días</option><option value="15" selected>15 días</option><option value="30">30 días</option></select>
            </div>
          </div>
          <div class="panel-pad">
            <div class="field"><label>Notas para el cliente</label><textarea id="kit-notes" placeholder="Ej: Precio especial por lanzamiento…"></textarea></div>
          </div>
          <div class="panel-head">
            <div><span class="eyebrow">Selección</span><h2>Pantallas del kit</h2></div>
            <span class="badge bd-ok" id="kit-sel-count">0 seleccionadas</span>
          </div>
          <div class="kit-list" id="kit-screen-list"></div>
        </div>

        <aside>
          <div class="panel" style="margin-bottom:14px">
            <div class="panel-head">
              <div><span class="eyebrow">Preview</span><h2>Documento</h2></div>
              <button class="btn ok" id="btn-save-kit">Archivar propuesta</button>
            </div>
            <div class="kit-doc" id="kit-preview"></div>
          </div>
          <div class="panel">
            <div class="panel-head"><div><span class="eyebrow">Historial</span><h2>Propuestas generadas</h2></div></div>
            <div class="kit-history" id="kit-history"></div>
          </div>
        </aside>
      </div>
    </section>

    <!-- METRICS -->
    <section class="section" id="sec-metrics">
      <div class="charts-grid">
        <div class="panel">
          <div class="panel-head"><div><span class="eyebrow">Métricas</span><h2>Reach diario por zona</h2></div></div>
          <div class="chart-rows" id="chart-zones"></div>
        </div>
        <div class="panel">
          <div class="panel-head"><div><span class="eyebrow">Distribución</span><h2>Tipos de tránsito</h2></div></div>
          <div class="chart-rows" id="chart-types"></div>
        </div>
      </div>
    </section>

    <!-- SETTINGS -->
    <section class="section" id="sec-settings">
      <div class="settings-grid">
        <div class="panel">
          <div class="panel-head"><div><span class="eyebrow">Marca</span><h2>Datos visibles</h2></div></div>
          <div class="panel-pad" style="display:grid;gap:11px">
            <div class="field"><label>Nombre de marca</label><input id="cfg-brand" type="text"></div>
            <div class="field"><label>Logo corto (2 letras)</label><input id="cfg-logo" type="text" maxlength="3"></div>
            <div class="field"><label>WhatsApp comercial</label><input id="cfg-wa" type="text" placeholder="5492616000000"></div>
          </div>
        </div>
        <div class="panel">
          <div class="panel-head"><div><span class="eyebrow">Plantilla</span><h2>Condiciones del media kit</h2></div></div>
          <div class="panel-pad" style="display:grid;gap:11px">
            <div class="field"><label>Validez por defecto</label>
              <select id="cfg-validity"><option value="7">7 días</option><option value="15">15 días</option><option value="30">30 días</option></select>
            </div>
            <div class="field"><label>Condiciones generales</label><textarea id="cfg-terms" style="min-height:100px"></textarea></div>
            <div class="field"><label>Hero title (brochure)</label><input id="cfg-hero" type="text"></div>
            <button class="btn ok" id="btn-cfg-save">Guardar configuración</button>
          </div>
        </div>
      </div>
    </section>
  </main>
</div>

<!-- Login View -->
<div class="login-view" id="login-view">
  <div class="login-box">
    <h2>Acceso al Dashboard</h2>
    <p>Ingresá tus credenciales para gestionar el inventario.</p>
    <form id="login-form">
      <div class="field"><label for="username">Usuario</label><input type="text" id="username" name="username" required></div>
      <div class="field"><label for="password">Contraseña</label><input type="password" id="password" name="password" required></div>
      <p id="login-error" style="color:var(--danger);font-size:12px;display:none;"></p>
      <button type="submit" class="btn pri">Ingresar</button>
    </form>
  </div>
</div>


<!-- Confirmation modal -->
<div class="modal-overlay" id="modal-overlay">
  <div class="modal">
    <h3 id="modal-title">¿Confirmar acción?</h3>
    <p id="modal-body">Esta acción no se puede deshacer.</p>
    <div class="modal-actions">
      <button class="btn" id="modal-cancel">Cancelar</button>
      <button class="btn danger" id="modal-confirm">Confirmar</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script src="shared.js"></script>
<script src="dashboard.js"></script>
</body>
</html>