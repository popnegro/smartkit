# ─────────────────────────────────────────────────────────
# SmartKit — Variables de entorno
# Copia este archivo como .env.local y completa los valores.
# NUNCA comitear .env.local al repositorio.
# ─────────────────────────────────────────────────────────

# Vercel Blob Storage
# Obtener desde: https://vercel.com/dashboard → Storage → Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_XXXXXXXXXXXXXXXX

# CORS — dominios permitidos separados por coma
# Ejemplo: https://smartkit.vercel.app,https://mi-dominio.com
ALLOWED_ORIGINS=http://localhost:3000

# Entorno (Vercel lo setea automáticamente: development | preview | production)
NODE_ENV=development
