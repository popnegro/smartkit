{
  "name": "smartkit",
  "version": "1.0.0",
  "description": "Aplicacion estatica para publicar un catalogo de pantallas DOOH, gestionarlas desde un dashboard local y generar media kits.",
  "main": "server.js",
  "directories": {
    "test": "tests"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "cssnano-cli": "^1.0.5",
    "terser": "^5.48.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "setup": "node setup-env.js",
    "test": "playwright test",
    "clean": "rm -rf dist",
    "clean:data": "rm -rf data/kits/*.json",
    "build": "npm run clean && mkdir -p dist && cp -R index.html dashboard.html mediakit.html styles.css app.js shared.js config.js screens-data.js assets data dist/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/popnegro/smartkit.git"
  },
  "author": "SmartKit Team",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/popnegro/smartkit/issues"
  },
  "homepage": "https://github.com/popnegro/smartkit#readme"
}
